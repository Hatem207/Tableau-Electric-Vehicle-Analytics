      <column caption='BEV Vehicles' datatype='integer' name='[Calculation_1867283208527872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot;&#13;&#10;THEN 1&#13;&#10;END' />
      </column>
      <column caption='BEV %' datatype='real' default-format='p0.00%' name='[Calculation_1867283209203713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1867283208527872]) / COUNT([VIN (1-10)])' />
      </column>
      <column caption='PHEV Vehicles' datatype='integer' name='[Calculation_1867283209850882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#13;&#10;THEN 1&#13;&#10;END' />
      </column>
      <column caption='PHEV %' datatype='real' default-format='p0.00%' name='[Calculation_1867283210158083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1867283209850882]) / COUNT([VIN (1-10)])' />
